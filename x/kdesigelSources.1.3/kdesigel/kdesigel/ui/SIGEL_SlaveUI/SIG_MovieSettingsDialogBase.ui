        <receiver>SIG_MovieSettingsDialogBase</receiver>
        <slot>slotToolButtonClicked()</slot>
    </connection>
    <connection>
        <sender>checkboxKeepAspectRatio</sender>
        <signal>toggled(bool)</signal>
        <receiver>SIG_MovieSettingsDialogBase</receiver>
        <slot>slotChangedAspectRatio(bool)</slot>
    </connection>
    <slot access="protected">slotChangedAspectRatio(bool)</slot>
    <slot access="protected">slotSetHeight(int)</slot>
    <slot access="protected">slotSetWidth(int)</slot>
    <slot access="public">slotToolButtonClicked()</slot>
</connections>
</UI>
