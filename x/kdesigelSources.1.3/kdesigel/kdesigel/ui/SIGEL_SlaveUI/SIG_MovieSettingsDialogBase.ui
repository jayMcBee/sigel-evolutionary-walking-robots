<connections>
    <connection>
        <sender>pushbuttonOK</sender>
        <signal>clicked()</signal>
        <receiver>SIG_MovieSettingsDialogBase</receiver>
        <slot>accept()</slot>
    </connection>
    <connection>
        <sender>pushbuttonCancel</sender>
        <signal>clicked()</signal>
        <receiver>SIG_MovieSettingsDialogBase</receiver>
        <slot>reject()</slot>
    </connection>
    <connection>
        <sender>toolbuttonDirectory</sender>
