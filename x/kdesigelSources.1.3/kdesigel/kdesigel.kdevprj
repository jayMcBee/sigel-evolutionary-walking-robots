[Config for BinMakefileAm]
addcxxflags=-DQT_THREAD_SUPPORT -DQT_ALTERNATE_QTSMANIP -fpermissive
bin_program=sigel
cflags=
cppflags=
cxxflags=\s-O3 -Wall
ldadd=\s-lqt -lX11
ldflags=\s   \s
libtool_dir=
path_to_bin_program=kdesigel

[General]
