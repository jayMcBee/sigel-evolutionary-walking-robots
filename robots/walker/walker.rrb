joint rotational leg6Joint1 {
	between body (bodyLeg6Base,bodyLeg6Dir,bodyLeg6Normal) and shoulder6 (shoulder6PredBase,shoulder6PredDir,shoulder6PredNormal);
	minimal -45;
	maximal 45;
	init 0;
}

