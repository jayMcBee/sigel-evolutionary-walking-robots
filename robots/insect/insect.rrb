material bodyMaterial {
	density 1;
	colour red 0 green 0 blue 1;
}

material legMaterial {
	density 1;
	colour red 0 green 1 blue 0;
}

material footMaterial {
	density 1;
	colour red 1 green 0 blue 0;
}

link body {
	torso;
	geometry "body.wrl";
	material bodyMaterial;
	point bodyLeg4Normal=(-0.99,0.06,0.23);
	point bodyLeg6Dir=(0.53,0.06,-0.46);
	point bodyLeg5Base=(-0.53,0.06,-0.46);
	point bodyLeg4Dir=(-0.66,0.06,-0.23);
	point bodyLeg4Base=(-0.66,0.06,0.23);
	point bodyLeg6Normal=(0.29,0.06,-0.96);
	point bodyLeg5Dir=(-0.13,0.06,-0.69);
	point bodyLeg1Normal=(1.06,0.06,-0.23);
	point bodyLeg6Base=(0.13,0.06,-0.69);
	point bodyLeg3Normal=(-0.27,0.06,0.93);
	point bodyLeg2Normal=(0.69,0.06,0.74);
	point bodyLeg1Base=(0.66,0.06,-0.23);
	point bodyLeg3Base=(-0.13,0.06,0.69);
	point bodyLeg2Base=(0.53,0.06,0.46);
	point bodyLeg2Dir=(0.13,0.06,0.69);
	point bodyLeg3Dir=(-0.53,0.06,0.46);
	point bodyLeg5Normal=(-0.7,0.06,-0.75);
	point bodyLeg1Dir=(0.66,0.06,0.23);
}

