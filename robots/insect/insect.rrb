joint rotational leg6Joint1 {
	between body (bodyLeg6Base,bodyLeg6Dir,bodyLeg6Normal) and leg6 (leg6PredBase,leg6PredDir,leg6PredNormal);
	minimal 45;
	maximal 80;
	init 45;
}

joint rotational leg5Joint2 {
	between leg5 (leg5SuccBase,leg5SuccDir,leg5SuccNormal) and foot5 (foot5PredBase,foot5PredDir,foot5PredNormal);
	minimal 0;
	maximal 35;
	init 0;
}

joint rotational leg6Joint2 {
	between leg6 (leg6SuccBase,leg6SuccDir,leg6SuccNormal) and foot6 (foot6PredBase,foot6PredDir,foot6PredNormal);
	minimal 0;
	maximal 35;
	init 0;
}

